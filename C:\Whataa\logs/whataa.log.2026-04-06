[2m2026-04-06T13:45:09.780897Z[0m [34mDEBUG[0m [2msqlx::query[0m[2m:[0m [3msummary[0m[2m=[0m"SELECT COALESCE(SUM(stock),0) as total_stock, …" [3mdb.statement[0m[2m=[0m"\n\n\n    SELECT COALESCE(SUM(stock),0) as total_stock, COALESCE(SUM(price_buy * stock),0) as stock_value,\n    COALESCE(SUM(price_seller * stock),0) as stock_value_seller,\n    COALESCE(SUM((price_seller - price_buy) * stock),0) as potential_marge,\n    COUNT(*) as total_article\n    FROM articles \n    \n" [3mrows_affected[0m[2m=[0m1 [3mrows_returned[0m[2m=[0m1 [3melapsed[0m[2m=[0m2.500208ms [3melapsed_secs[0m[2m=[0m0.002500208
[2m2026-04-06T13:45:09.783495Z[0m [34mDEBUG[0m [2msqlx::query[0m[2m:[0m [3msummary[0m[2m=[0m"SELECT COALESCE(SUM(montant_vente),0) - COALESCE(SUM(montant_regle),0) …" [3mdb.statement[0m[2m=[0m"\n\n\n    SELECT COALESCE(SUM(montant_vente),0) - COALESCE(SUM(montant_regle),0) as total_solde\n    FROM tiers \n    LEFT JOIN (\n        SELECT tier_id, SUM(montant_net) as montant_vente\n        FROM documents\n        WHERE type_doc = 2\n        GROUP BY tier_id\n    ) as ventes ON ventes.tier_id = tiers.id\n    LEFT JOIN (\n        SELECT tier_id, SUM(montant) as montant_regle\n        FROM reglements\n        GROUP BY tier_id\n    ) as regles ON regles.tier_id = tiers.id\n    WHERE type_tier = 'CLIENT'\n    \n" [3mrows_affected[0m[2m=[0m1 [3mrows_returned[0m[2m=[0m1 [3melapsed[0m[2m=[0m2.343ms [3melapsed_secs[0m[2m=[0m0.002343
[2m2026-04-06T13:45:09.785941Z[0m [34mDEBUG[0m [2msqlx::query[0m[2m:[0m [3msummary[0m[2m=[0m"SELECT COALESCE(SUM(montant_achat),0) - COALESCE(SUM(montant_regle),0) …" [3mdb.statement[0m[2m=[0m"\n\n\n    SELECT COALESCE(SUM(montant_achat),0) - COALESCE(SUM(montant_regle),0) as total_solde\n    FROM tiers \n    LEFT JOIN (\n        SELECT tier_id, SUM(montant_net) as montant_achat\n        FROM documents\n        WHERE type_doc = 1\n        GROUP BY tier_id\n    ) as ventes ON ventes.tier_id = tiers.id\n    LEFT JOIN (\n        SELECT tier_id, SUM(montant) as montant_regle\n        FROM reglements\n        GROUP BY tier_id\n    ) as regles ON regles.tier_id = tiers.id\n    WHERE type_tier = 'FOURNISSEUR'\n    \n" [3mrows_affected[0m[2m=[0m1 [3mrows_returned[0m[2m=[0m1 [3melapsed[0m[2m=[0m2.189333ms [3melapsed_secs[0m[2m=[0m0.002189333
[2m2026-04-06T13:45:09.796732Z[0m [34mDEBUG[0m [2msqlx::query[0m[2m:[0m [3msummary[0m[2m=[0m"WITH months AS ( …" [3mdb.statement[0m[2m=[0m"\n\n\n       WITH months AS (\n        SELECT generate_series(\n            date_trunc('year', CURRENT_DATE),\n            date_trunc('year', CURRENT_DATE) + interval '11 months',\n            interval '1 month'\n        ) AS mois\n        )\n        SELECT\n        TO_CHAR(m.mois, 'TMMonth') AS mois,\n        EXTRACT(MONTH FROM m.mois)::INT AS mois_num,\n        COALESCE(SUM(d.montant_net), 0) AS total_vente\n        FROM months m\n        LEFT JOIN documents d\n        ON date_trunc('month', d.created_at) = m.mois\n        AND d.type_doc = 2\n        GROUP BY m.mois\n        ORDER BY mois_num;\n        \n" [3mrows_affected[0m[2m=[0m12 [3mrows_returned[0m[2m=[0m12 [3melapsed[0m[2m=[0m10.560125ms [3melapsed_secs[0m[2m=[0m0.010560125
